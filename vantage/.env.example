# ============================================================================
# Vantage — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://vantage:vantage@localhost:5432/vantage
POSTGRES_USER=vantage
POSTGRES_PASSWORD=vantage
POSTGRES_DB=vantage

# --- Cache / Queue ---------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- API Gateway -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000

# --- UI --------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Vantage

# --- Auth (NextAuth v5 / Auth.js) ------------------------------------------
# Generate a strong secret: `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Resend (https://resend.com) — free tier ships 3,000 emails / month.
# For production, verify a sending domain and update EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM="Vantage <login@example.com>"
# Hardcoded admin email for the /v1/portfolios/system/rebuild endpoint.
# Phase 10 replaces this with proper RBAC.
ADMIN_EMAIL=
# Override the nightly system-portfolio rebuild cron pattern (default: 0 2 * * * UTC).
SYSTEM_PORTFOLIO_CRON=

# --- ML Service ------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_API_KEY=dev-only-change-in-prod

# --- Public-market data (FMP) ----------------------------------------------
# Free tier: 250 calls/day. Starter $22/mo, Premium $79/mo.
FMP_API_KEY=

# --- Private-side alt-data sources (all free) ------------------------------
SEC_USER_AGENT="Vantage Research will@example.com"
FRED_API_KEY=
GITHUB_TOKEN=
USPTO_API_KEY=
GOOGLE_TRENDS_PROXY_URL=
BUILTWITH_API_KEY=

# --- Company intel (Anthropic Messages API + web_search) -------------------
# The only LLM step in the private scoring path — extracts structured
# revenue / headcount / funding data, never decisions.
ANTHROPIC_API_KEY=

# --- Logging / Observability (optional) ------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
