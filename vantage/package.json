{
  "name": "vantage",
  "version": "0.1.0",
  "private": true,
  "description": "Sector-agnostic financial intelligence platform. Private + public scoring, classification, portfolio, simulation.",
  "author": "Will Faulk <wpf002@github>",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "pnpm --filter @vantage/api db:generate",
    "db:migrate": "pnpm --filter @vantage/api db:migrate",
    "db:seed": "pnpm --filter @vantage/api db:seed",
    "db:studio": "pnpm --filter @vantage/api db:studio",
    "ml:dev": "cd services/ml-service && uvicorn app.main:app --reload --reload-dir app --port 8001",
    "ml:test": "cd services/ml-service && pytest",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
