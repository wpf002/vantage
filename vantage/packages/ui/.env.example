# UI environment — duplicates the root .env.example for clarity. In dev,
# `pnpm dev` runs Next from the repo root via Turbo and picks up the root
# .env automatically; this file documents what the UI specifically needs.

NEXT_PUBLIC_API_URL=http://localhost:4000

# NextAuth v5 — generate with `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Vantage <login@example.com>"

# Drizzle adapter — same database the API writes to
DATABASE_URL=postgresql://vantage:vantage@localhost:5432/vantage

# Admin gate for the /meta meta-learning surface — must match the API's ADMIN_EMAIL.
# When unset, /meta returns notFound for everyone and the Meta nav link is hidden.
ADMIN_EMAIL=you@example.com
