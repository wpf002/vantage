{
  "name": "@vantage/cli",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "bin": {
    "vantage": "./dist/index.js"
  },
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo 'lint stub'",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "portfolio-build": "tsx --env-file=../../.env src/index.ts portfolio-build",
    "meta-backfill": "tsx --env-file=../../.env src/index.ts meta-backfill"
  },
  "dependencies": {
    "@vantage/api": "workspace:*",
    "@vantage/core-private": "workspace:*",
    "@vantage/core-public": "workspace:*",
    "@vantage/data-ingest": "workspace:*",
    "@vantage/portfolio": "workspace:*",
    "@vantage/shared": "workspace:*",
    "@vantage/simulation": "workspace:*",
    "bullmq": "^5.34.0",
    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.36.0",
    "ioredis": "^5.4.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
